{"nodes": [{"id": "ams_fluxogramas", "label": "AMS Fluxogramas (PlantUML flowcharts)", "file_type": "document", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ams_fluxogramas_watchdog_wwdg", "label": "Watchdog WWDG startup flow", "file_type": "concept", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 01", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reset cause is saved before enabling the watchdog so a boot can be classified as normal reset vs hang recovery; watchdog frozen when debugger attached to allow breakpoints; refresh before and after each brain_loop pass."}, {"id": "ams_fluxogramas_systick_scheduler", "label": "1 ms SysTick task scheduler", "file_type": "concept", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 02", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 1 ms interrupt does no heavy work, only raises flags (faultCheck 250 ms, updateUI 800 ms, runtime_sec 1 s); the main loop executes tasks on the next pass, keeping ISR load minimal."}, {"id": "ams_fluxogramas_ams_state_machine", "label": "AMS main state machine (AMSStates_t)", "file_type": "concept", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 03", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "States: STARTUP, IDLE, BALANCING, CHARGING, RESET_ISA, FAULT. Boots in first-full-read STARTUP, rests in IDLE, leaves IDLE only on CAN orders; any invalid state falls to FAULT."}, {"id": "ams_fluxogramas_idle_measurement_cycle", "label": "Idle measurement cycle (ADBMS phased reads)", "file_type": "concept", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 04", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slave reads are done in short non-blocking phases (fire conversion, leave, return later to read) so the main loop never blocks; ends with open-wire tests and a data snapshot (memcpy SLAVE, IC) for the rest of the firmware."}, {"id": "ams_fluxogramas_balancing_cycle", "label": "Cell balancing cycle (BAL_CYCLE)", "file_type": "concept", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 05", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discharge pulse is 1.5 s, deliberately below the 1.8 s tSLEEP internal watchdog of the ADBMS chips which would silently kill discharge switches and sleep; die-temp guard (85 C twice in a row) ends balancing with a registered fault; target is the minimum frozen at session start."}, {"id": "ams_fluxogramas_precharge_sequence", "label": "Precharge contactor sequence", "file_type": "concept", "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 06", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bus capacitor is charged through the precharge resistor before closing the positive contactor because inrush current would weld it; every contactor close is confirmed via feedback and any wrong feedback aborts to KILL; current/bus-voltage verifications are stubs (IsCurrentOK/IsBusVoltageOK return true) reserved as entry points for the future protection layer."}], "edges": [{"source": "ams_fluxogramas", "target": "ams_fluxogramas_watchdog_wwdg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 01", "weight": 1.0}, {"source": "ams_fluxogramas", "target": "ams_fluxogramas_systick_scheduler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 02", "weight": 1.0}, {"source": "ams_fluxogramas", "target": "ams_fluxogramas_ams_state_machine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 03", "weight": 1.0}, {"source": "ams_fluxogramas", "target": "ams_fluxogramas_idle_measurement_cycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 04", "weight": 1.0}, {"source": "ams_fluxogramas", "target": "ams_fluxogramas_balancing_cycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 05", "weight": 1.0}, {"source": "ams_fluxogramas", "target": "ams_fluxogramas_precharge_sequence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 06", "weight": 1.0}, {"source": "ams_fluxogramas_ams_state_machine", "target": "ams_fluxogramas_idle_measurement_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "sections 03-04 (IDLE state runs the 50 ms measurement cycle)", "weight": 1.0}, {"source": "ams_fluxogramas_ams_state_machine", "target": "ams_fluxogramas_balancing_cycle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "sections 03/05 (BALANCING state runs the BAL_CYCLE machine)", "weight": 1.0}, {"source": "ams_fluxogramas_systick_scheduler", "target": "ams_fluxogramas_ams_state_machine", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "sections 02-03 (250 ms flag drives safety check + CAN TX in IDLE/CHARGING)", "weight": 1.0}, {"source": "ams_fluxogramas_watchdog_wwdg", "target": "firmware_core_src_brain", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 01 footnote (main.c WWDG, refresh around brain_loop)", "weight": 1.0}, {"source": "ams_fluxogramas_systick_scheduler", "target": "firmware_core_src_brain", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 02 footnote (brain.c HAL_SYSTICK_Callback)", "weight": 1.0}, {"source": "ams_fluxogramas_ams_state_machine", "target": "firmware_core_src_brain", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 03 footnote (brain.c brain_loop, AMSStates_t)", "weight": 1.0}, {"source": "ams_fluxogramas_precharge_sequence", "target": "firmware_core_src_precharge_precharge_update", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AMS_FLUXOGRAMAS.md", "source_location": "section 06 footnote (precharge.c Precharge_Update, PrechargeState_t)", "weight": 1.0}], "hyperedges": [{"id": "ams_firmware_operational_flows", "label": "Critical AMS firmware operational flows", "nodes": ["ams_fluxogramas_watchdog_wwdg", "ams_fluxogramas_systick_scheduler", "ams_fluxogramas_ams_state_machine", "ams_fluxogramas_idle_measurement_cycle", "ams_fluxogramas_balancing_cycle", "ams_fluxogramas_precharge_sequence"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AMS_FLUXOGRAMAS.md"}]}